---
/**
 * 套餐价格对比区块。内容在 src/config/site.ts 的 `pricing` 中配置，
 * 支持任意数量的套餐（配置里加对象即可），文案按当前语言自动显示。
 */
import { LinkButton } from '@astrojs/starlight/components';
import { siteConfig } from '../config/site';
import { localizeHref, resolveSiteLocale, t } from '../lib/i18n';

const locale = resolveSiteLocale(Astro.locals.starlightRoute.locale);
const { title, description, plans } = siteConfig.pricing;
---

<section class="bc-section bc-pricing not-content" id="pricing">
	<h2>{t(title, locale)}</h2>
	<p class="bc-section-desc">{t(description, locale)}</p>
	<div class="bc-plan-grid">
		{
			plans.map((plan) => (
				<article class:list={['bc-plan', { 'bc-plan--highlight': plan.highlight }]}>
					{plan.badge && <span class="bc-plan-badge">{t(plan.badge, locale)}</span>}
					<h3>{t(plan.name, locale)}</h3>
					<p class="bc-plan-desc">{t(plan.description, locale)}</p>
					<p class="bc-plan-price">
						<strong>{t(plan.price, locale)}</strong>
						{plan.priceNote && <span>{t(plan.priceNote, locale)}</span>}
					</p>
					<ul class="bc-plan-features">
						{plan.features.map((feature) => (
							<li>
								<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<path d="m4 12.5 5.5 5.5L20 6.5" />
								</svg>
								<span>{t(feature, locale)}</span>
							</li>
						))}
					</ul>
					<LinkButton
						href={localizeHref(plan.cta.href, locale)}
						variant={plan.cta.variant ?? (plan.highlight ? 'primary' : 'secondary')}
						class="bc-plan-cta"
					>
						{t(plan.cta.label, locale)}
					</LinkButton>
				</article>
			))
		}
	</div>
</section>

<style>
	.bc-section {
		margin-block: 3rem;
		padding-bottom: 3rem;
	}
	.bc-section h2 {
		margin: 0;
		font-size: var(--sl-text-3xl);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
		color: var(--sl-color-white);
		text-align: center;
	}
	.bc-section-desc {
		margin: 0.75rem auto 0;
		max-width: 44rem;
		text-align: center;
		color: var(--sl-color-gray-2);
	}

	.bc-plan-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.25rem;
		margin-top: 2rem;
		align-items: stretch;
	}

	.bc-plan {
		position: relative;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		padding: 1.5rem 1.5rem 1.75rem;
		background: var(--sl-color-bg);
	}
	.bc-plan--highlight {
		border-color: var(--sl-color-text-accent);
		background: color-mix(in oklab, var(--sl-color-text-accent) 7%, var(--sl-color-bg));
	}
	.bc-plan-badge {
		position: absolute;
		top: -0.8rem;
		inset-inline-end: 1.25rem;
		border-radius: 999rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-xs);
		line-height: 1;
		padding: 0.35rem 0.75rem;
		font-weight: 600;
	}
	.bc-plan h3 {
		margin: 0;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
		color: var(--sl-color-white);
	}
	.bc-plan-desc {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.bc-plan-price {
		margin: 1.25rem 0 0;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}
	.bc-plan-price strong {
		font-size: var(--sl-text-4xl);
		color: var(--sl-color-white);
		line-height: 1.1;
	}
	.bc-plan-price span {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.bc-plan-features {
		list-style: none;
		margin: 1.25rem 0 1.5rem;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		flex: 1;
	}
	.bc-plan-features li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-1);
	}
	.bc-plan-features svg {
		width: 1em;
		height: 1em;
		margin-top: 0.2em;
		flex-shrink: 0;
		color: var(--sl-color-text-accent);
	}

	.bc-plan-cta {
		justify-content: center;
	}
</style>
